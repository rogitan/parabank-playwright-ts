{
  "name": "playwright-typescript-strapoint-framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test --workers=3",
    "test:smoke": "npx playwright test --project=smoke",
    "test:regression": "npx playwright test --project=regression",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "report:open": "npx playwright show-report",
    "report": "npx playwright show-report html-report",
    "allure:clean": "npx rimraf ./allure-report ./allure-results",
    "allure:quality-gate": "npx allure quality-gate -c allurerc.mjs ./allure-results",
    "test:run_test_allure": "npx allure run -c allurerc.mjs --output ./allure-report -- npx playwright test tests/login.spec.ts --project=GChrome --headed",
    "allure:open": "npx allure open ./allure-report",
    "test:run_all_allure": "npm run allure:clean && npx allure run -c allurerc.mjs --output ./allure-report -- npx playwright test --project=regression --headed && npm run allure:open",
    "test:run_all_allure_no_qg": "npm run allure:clean && npx playwright test --project=regression --headed && npx allure generate ./allure-results --output ./allure-report --clean && npm run allure:open",
    "generate-auth": "ts-node scripts/generate-auth-context.ts"
  },
  "keywords": [],
  "author": "Rogi G. Tan",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.3.1",
    "allure": "^3.3.1",
    "allure-playwright": "^3.6.0",
    "playwright": "^1.58.0",
    "playwright-qase-reporter": "^2.2.2",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@playwright/cli": "^0.1.13",
    "@playwright/mcp": "^0.0.75",
    "dotenv": "^17.3.1",
    "fs-extra": "^11.3.1"
  }
}
